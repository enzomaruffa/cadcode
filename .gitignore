
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Python / backend
__pycache__/
*.py[cod]
.venv/
backend/.venv/
.pytest_cache/
.ruff_cache/

# Node / frontend
node_modules/
frontend/dist/
*.tsbuildinfo

# Per-session model checkpoint repo (its own nested git repo)
backend/.workspace/

# Verification / scratch artifacts
*.png
.playwright-mcp/
.DS_Store

# Built SPA copied into the backend at image-build time
backend/static/

# Runtime-created projects + folder-store snapshots (user data, per-container)
backend/projects/
backend/.workspace/

# Repo skills are shared (override the user-global `.claude` ignore); local settings stay ignored.
!.claude/
.claude/*
!.claude/skills/
